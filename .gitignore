# build output — regenerable
dist/

# git worktrees checked out inside the project
worktrees/

# secrets — never commit
.forge/secrets/

# OS / editor noise
.DS_Store
*.swp
*.swo
*~
.vscode/
.idea/

# python (helpers in .forge/lib/)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# obsidian workspace state is per-user; the shared config lives in app.json/graph.json
.obsidian/workspace
.obsidian/workspace.json
.obsidian/workspaces.json
.obsidian/cache

# agent related
.claude/
CLAUDE.md
AGENTS.md
GEMINI.md
OBSIDIAN.md

# derived wiki index — regenerated by .forge/lib/index.py
wiki/.meta/

# derived lint health snapshot — regenerated on every lint run
.forge/lint-report.md

# derived cited-by sweep state — regenerated by .forge/lib/citations.py
.forge/citations-cache.json
.forge/citations-report.md

# raw-source conversion intermediates — regenerated by .forge/lib/normalize.py
*.converted/
